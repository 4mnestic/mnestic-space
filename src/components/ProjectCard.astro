---
import AsciiBox from './AsciiBox.astro';
import CheckersMCTS from './CheckersMCTS.astro';
import PacmanSearch from './PacmanSearch.astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  visual?: 'checkers' | 'pacman';
  github?: string;
  paper?: string;
}

const { title, description, tags, visual, github, paper } = Astro.props;
---

<AsciiBox class="project-card">
  <div class="layout">
    {visual && (
      <div class="visual">
        {visual === 'checkers' && <CheckersMCTS />}
        {visual === 'pacman' && <PacmanSearch />}
      </div>
    )}
    <div class="text">
      <h3>{title}</h3>
      <div class="tags">
        {tags.map(tag => <span class="tag">[{tag}]</span>)}
      </div>
      <p class="card-desc">{description}</p>
      <p class="links">
        {github && <a href={github} target="_blank" rel="noopener noreferrer">&gt;&gt; code on github</a>}
        {paper && <a href={paper} target="_blank" rel="noopener noreferrer">&gt;&gt; read the pdf</a>}
      </p>
    </div>
  </div>
</AsciiBox>

<style>
.layout {
  display: grid;
  grid-template-columns: 400px 1fr;
  gap: 2rem;
  align-items: center;
}

.visual {
  min-width: 0;
}

.text {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

h3 {
  color: var(--color-accent-1);
  letter-spacing: 0.05em;
}

.card-desc {
  color: var(--color-text);
  font-size: 0.9rem;
  line-height: 1.7;
  max-width: 60ch;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.tag {
  font-size: 0.75rem;
  color: var(--color-border);
}

.links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  font-size: 0.85rem;
}

@media (max-width: 800px) {
  .layout {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}
</style>
