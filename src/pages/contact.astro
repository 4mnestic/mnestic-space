---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiBox from '../components/AsciiBox.astro';
---

<BaseLayout title="Contact" description="Get in touch with me.">

  {/* Text starting with "//" must be an expression: the Astro compiler drops the whole element otherwise. */}
  <h2 class="page-title">{"// CONTACT"}</h2>

  <AsciiBox>
    <div class="contact-list">
      <div class="contact-row">
        <span class="contact-label unlinked">email</span>
        <span>zachk (@ my school's email domain)</span>
      </div>
      <div class="contact-row">
        <a class="contact-label" href="https://github.com/4mnestic" target="_blank" rel="noopener noreferrer">github</a>
        <span>github.com/4mnestic</span>
      </div>
      <div class="contact-row">
        <a class="contact-label" href="https://linkedin.com/in/zkey" target="_blank" rel="noopener noreferrer">linkedin</a>
        <span>linkedin.com/in/zkey</span>
      </div>
    </div>
  </AsciiBox>

</BaseLayout>

<style>
.page-title {
  margin-bottom: 1rem;
  color: var(--color-accent-1);
  font-size: 1.2rem;
  letter-spacing: 0.1em;
}

.contact-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.contact-row {
  display: flex;
  gap: 2rem;
  align-items: baseline;
  flex-wrap: wrap;
}

.contact-label {
  min-width: 8ch;
  font-size: 0.85rem;
}

.contact-label.unlinked {
  color: var(--color-border);
}
</style>
