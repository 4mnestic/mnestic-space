---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiImage from '../components/AsciiImage.astro';
---

<BaseLayout title="Home" description="Zach Keyes/mnestic's portfolio">
  <section class="hero section">
    <h1 class="site-name">ZACH KEYES // MNESTIC</h1>
  </section>

  <section class="intro section">
    <div class="avatar-float">
      <AsciiImage
        src="/images/avatar.jpg"
        alt="mnestic"
        width={280}
      />
    </div>
    <p>
      Welcome to my website/portfolio. This is a place for me to put cool stuff.
    </p>
    <p>
      I am a graduate student at the University of Arizona, studying information science with an emphasis in machine learning. I'm also studying for the actuarial exams P and FM. I also do lots of projects for fun, some of which I complete and put here.
    </p>
  </section>

  <section class="section">
    <p>
      <a href="/projects">&gt;&gt; my projects</a>
      &nbsp;&nbsp;
      <a href="/about">&gt;&gt; about me</a>
    </p>
  </section>
</BaseLayout>

<style>
.site-name {
  font-size: 2.5rem;
  letter-spacing: 0.15em;
  margin-bottom: 0.5rem;
}

.intro {
  display: flow-root;
  max-width: calc(280px + 2rem + 60ch);
}

.avatar-float {
  float: left;
  margin: 0 2rem 1rem 0;
}

.intro p {
  max-width: none;
  line-height: 1.7;
}

.intro p + p {
  margin-top: 1rem;
}

@media (max-width: 600px) {
  .avatar-float {
    float: none;
    margin-right: 0;
  }
}
</style>
