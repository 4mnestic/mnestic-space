---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiImage from '../components/AsciiImage.astro';
---

<BaseLayout title="Home" description="Zach Keyes/mnestic's portfolio">
  <section class="hero section">
    <h1 class="site-name">ZACH KEYES</h1>
  </section>

  <section class="avatar-section section">
    <div class="avatar-layout">
      <AsciiImage
        src="/images/avatar.jpg"
        alt="mnestic"
        width={280}
      />
    </div>
  </section>

  <section class="intro section">
    <p>
      Welcome to my website/portfolio. This is a place for me to put cool stuff.

      I am a graduate student at the University of Arizona, studying information science with an emphasis in machine learning. I'm also studying for the actuarial exams P and FM. I also do lots of projects for fun, some of which I complete and put here. 
    </p>
  </section>

  <section class="section">
    <p>
      <a href="/projects">&gt;&gt; view my projects</a>
      &nbsp;&nbsp;
      <a href="/about">&gt;&gt; about me</a>
    </p>
  </section>
</BaseLayout>

<style>
.site-name {
  font-size: 2.5rem;
  letter-spacing: 0.15em;
  margin-bottom: 0.5rem;
}

.tagline {
  color: var(--color-accent-1);
  font-size: 1rem;
  margin-bottom: 2rem;
  max-width: 55ch;
}

.avatar-section {
  margin-bottom: 2rem;
}

.avatar-layout {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
  align-items: flex-start;
}

.intro p {
  max-width: 60ch;
  line-height: 1.7;
}
</style>
